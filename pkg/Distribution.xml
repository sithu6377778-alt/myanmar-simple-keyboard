<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Myanmar Simple Keyboard</title>
    <organization>com.linnlabs</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="15.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="com.linnlabs.inputmethod.MyanmarSimple.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.linnlabs.inputmethod.MyanmarSimple.pkg" visible="false">
        <pkg-ref id="com.linnlabs.inputmethod.MyanmarSimple.pkg"/>
    </choice>
    <pkg-ref id="com.linnlabs.inputmethod.MyanmarSimple.pkg" version="__VERSION__" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
